# Dependencies
astro/node_modules/

# Astro build output
astro/dist/
astro/.vercel/

# Environment variables
astro/.env
astro/.env.local
astro/.env.*.local

# WordPress core (only theme is tracked)
wordpress/*.php
wordpress/wp-admin/
wordpress/wp-includes/
wordpress/wp-content/index.php
wordpress/wp-content/plugins/
wordpress/wp-content/uploads/
wordpress/wp-content/upgrade/
wordpress/wp-content/themes/twenty*/
wordpress/wp-content/themes/index.php
wordpress/wp-content/languages/
wordpress/wp-content/debug.log
wordpress/xmlrpc.php
wordpress/license.txt
wordpress/readme.html
wordpress/wp-config.php
wordpress/wp-config-sample.php
wordpress/index.php

# DDEV — track config.yaml etc. for reproducible local setup.
# DDEV's own .ddev/.gitignore excludes the generated artifacts.
# .env.web holds a local YOUTUBE_API_KEY — keep out of git
wordpress/.ddev/.env.web

# OS files
.DS_Store
Thumbs.db

# Seed scripts
wordpress/seed*.php
