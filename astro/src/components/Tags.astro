---
interface Props {
  tags: { name: string; slug: string }[];
  taxonomy?: 'subject' | 'format';
}

const { tags, taxonomy = 'subject' } = Astro.props;
const basePath = taxonomy === 'subject' ? '/subject' : '/format';
---

{tags.length > 0 && (
  <div class="flex flex-wrap gap-2 font-mono uppercase text-xs">
    {tags.map((t) => (
      <a
        href={`${basePath}/${t.slug}`}
        class="inline-block px-4 py-1 border border-black rounded-md no-underline text-inherit hover:bg-highlighter hover:rounded-3xl transition-[background-color,border-radius] duration-150"
      >{t.name}</a>
    ))}
  </div>
)}
