---
import TalkItem from './TalkItem.astro';
import IssueMeta from './IssueMeta.astro';
import IssueExpand from './IssueExpand.svelte';
import DotDivider from './DotDivider.astro';
import Button from './Button.astro';
import { renderLatex } from '../lib/katex';
import { optimizeImages } from '../lib/images';
import { rewriteContentLinks } from '../lib/links';
import { groupByVolume, formatVolumeHeading } from '../lib/utils';

interface Props {
  blocks: any[];
  currentIssueData?: any;
  allIssuesData?: any[];
  issueSettings?: { expandable: boolean };
  talkIssueMap: Map<string, string>;
}

const {
  blocks,
  currentIssueData = null,
  allIssuesData = [],
  issueSettings = { expandable: true },
  talkIssueMap,
} = Astro.props;
---

{blocks.map((block) => {
  const anchorId = block.anchor
    ? String(block.anchor).toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '')
    : '';
  const inner = (() => {
    switch (block.acf_fc_layout) {
    case 'intro_text':
      return (
        <div class="grid grid-cols-12 mt-4 pb-3 md:pb-5">
          <p class="col-span-12 sm:col-span-11 md:col-span-10 lg:col-span-9 font-sans text-base sm:text-lg md:text-xl lg:text-2xl xl:text-3xl leading-relaxed md:leading-snug" set:html={rewriteContentLinks(renderLatex(block.content || ''), talkIssueMap)} />
        </div>
      );

    case 'long_form_text': {
      const alignment = block.centered ? ' mx-auto' : '';
      return (
        <section class={`long-form-text mt-8 max-w-[710px]${alignment}`} set:html={rewriteContentLinks(optimizeImages(renderLatex(block.text || block.content || '')), talkIssueMap)} />
      );
    }

    case 'current_issue':
      return currentIssueData ? (
        <section>
          <IssueMeta
            issueNumber={currentIssueData.acf.issue_number}
            volumeNumber={currentIssueData.acf.volume_number}
            publicationDate={currentIssueData.acf.publication_date}
            issueColor={currentIssueData.acf.issue_color}
            summary={currentIssueData.acf.issue_summary}
            showBorder
          />
          {currentIssueData.talks.map((talk: any) => (
            <TalkItem
              title={talk.acf.talk_title_latex}
              slug={talk.slug}
              issueSlug={currentIssueData.slug}
              speakers={talk.acf.speakers}
              subjectAreas={talk.subject_areas}
              issueColor={currentIssueData.acf.issue_color}
              talkDate={talk.acf.talk_date}
              hostInstitution={talk.acf.host_institution}
              duration={talk.acf.video_duration}
              compact
            />
          ))}
        </section>
      ) : null;

    case 'issue_list': {
      const volumeGroups = groupByVolume(allIssuesData);
      return (
        <div>
          {volumeGroups.map(([volumeNumber, issues]) => (
            <section class="mt-6 md:mt-8">
              <DotDivider />
              <h2 class="font-serif lining-nums text-2xl md:text-3xl lg:text-4xl leading-tight mt-5 md:mt-6">{formatVolumeHeading(volumeNumber)}</h2>
              {issues.map((issue: any) => (
                <div data-spot-color={issue.acf.issue_color} data-spot-gated>
                  <IssueMeta
                    issueNumber={issue.acf.issue_number}
                    publicationDate={issue.acf.publication_date}
                    issueColor={issue.acf.issue_color}
                    summary={issue.acf.issue_summary}
                    issueSlug={issue.slug}
                  >
                    {issueSettings.expandable && issue.talks.length > 0 && (
                      <IssueExpand
                        slot="action"
                        client:load
                        talkCount={issue.talks.length}
                        targetId={`talks-${issue.slug}`}
                      />
                    )}
                  </IssueMeta>
                  {issueSettings.expandable && issue.talks.length > 0 && (
                    <div id={`talks-${issue.slug}`} data-expand-gate hidden>
                      {issue.talks.map((talk: any) => (
                        <TalkItem
                          title={talk.acf.talk_title_latex}
                          slug={talk.slug}
                          issueSlug={issue.slug}
                          speakers={talk.acf.speakers}
                          subjectAreas={talk.subject_areas}
                          issueColor={issue.acf.issue_color}
                          talkDate={talk.acf.talk_date}
                          hostInstitution={talk.acf.host_institution}
                          duration={talk.acf.video_duration}
                          compact
                        />
                      ))}
                    </div>
                  )}
                </div>
              ))}
            </section>
          ))}
        </div>
      );
    }

    case 'talk_grid':
      return (
        <section>
          {block.heading && <h2 class="font-serif text-xl md:text-2xl mt-10">{block.heading}</h2>}
          {block.talks && block.talks.length > 0 ? (
            block.talks.filter((talk: any) => talk.issue_slug).map((talk: any) => (
              <TalkItem
                title={talk.post_title}
                slug={talk.post_name}
                issueSlug={talk.issue_slug}
                speakers={talk.acf?.speakers || []}
                subjectAreas={talk.subject_areas}
                issueColor={talk.acf?.related_issue?.[0]?.acf?.issue_color}
                talkDate={talk.acf?.talk_date}
                hostInstitution={talk.acf?.host_institution}
                duration={talk.acf?.video_duration}
              />
            ))
          ) : (
            <p><em>No talks selected.</em></p>
          )}
        </section>
      );

    case 'issue_item':
      return (
        <section>
          {block.issue && block.issue[0] && (
            <a href={`/issue/${block.issue[0].post_name}`} class="font-serif">
              {block.issue[0].post_title}
            </a>
          )}
        </section>
      );

    case 'email_signup':
      return (
        <section>
          {block.heading && <h3 class="font-mono text-sm">{block.heading}</h3>}
          {block.description && <p class="font-sans text-base">{block.description}</p>}
          {block.embed_code ? (
            <div set:html={block.embed_code} />
          ) : (
            <p class="font-mono text-sm"><em>[Email signup form will be configured here]</em></p>
          )}
        </section>
      );

    case 'editors_group':
      return (
        <section class="mt-10 md:mt-14 grid grid-cols-12 gap-4 lg:gap-8">
          {block.heading && (
            <h2 class="col-span-12 lg:col-span-3 font-serif text-xl md:text-2xl">{block.heading}</h2>
          )}
          <div class="col-span-12 lg:col-span-9">
            {block.people && block.people.length > 0 ? (
              <table class="w-full md:w-auto md:table-fixed">
                <colgroup>
                  <col class="md:w-72" />
                  <col class="md:w-80 hidden md:table-column" />
                </colgroup>
                <thead>
                  <tr class="font-sans text-sm">
                    <th class="border-t border-black text-left py-2 font-normal">Name</th>
                    <th class="border-t border-black text-left py-2 font-normal hidden md:table-cell">Host Institution</th>
                  </tr>
                </thead>
                <tbody class="font-sans">
                  {block.people.map((person: any) => {
                    const acf = person.acf || {};
                    const links = acf.related_links || [];
                    const dates = acf.dates_affiliated || [];
                    const parseYear = (v: string) => v ? (v.includes('-') ? v.slice(0, 4) : v.slice(0, 4)) : '';
                    const dateStr = dates.length > 0 ? dates.map((d: any) => {
                      const start = parseYear(d.start_date);
                      const end = d.end_date ? parseYear(d.end_date) : 'present';
                      return start ? `${start}–${end}` : '';
                    }).filter(Boolean).join(', ') : '';
                    return (
                      <tr>
                        <td class="border-t border-black/10 py-3 align-top">
                          <span class="font-sans text-base md:text-lg">{person.post_title}</span>
                          {dateStr && <span class="block text-sm text-black/70 mt-0.5">{dateStr}</span>}
                          <span class="md:hidden block text-sm">{acf.institution}</span>
                          {links.length > 0 && (
                            <div class="flex gap-3 mt-1">
                              {links.map((link: any) => (
                                <a href={link.url} class="text-sm underline hover:bg-highlighter transition-colors">{link.label}</a>
                              ))}
                            </div>
                          )}
                        </td>
                        <td class="border-t border-black/10 py-3 align-top text-sm hidden md:table-cell">{acf.institution}</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            ) : (
              <p><em>No people assigned.</em></p>
            )}
          </div>
        </section>
      );

    case 'cta_block':
      return (
        <section class="mt-10 md:mt-12 mb-10 md:mb-12">
          {block.heading && <h3 class="font-serif text-2xl md:text-3xl lg:text-4xl leading-tight">{block.heading}</h3>}
          {block.description && <p class="font-sans text-base md:text-lg lg:text-xl mt-2 md:mt-3">{block.description}</p>}
          <div class="flex flex-wrap gap-4 mt-5 md:mt-6">
            {(block.buttons || []).map((btn: any) => {
              const pageSlug = btn.page?.post_name || btn.page?.slug;
              const href =
                btn.link_type === 'email' ? `mailto:${btn.email}` :
                btn.link_type === 'file'  ? btn.file :
                btn.link_type === 'page'  ? (pageSlug ? `/${pageSlug}` : '') :
                btn.url;
              const isDownload = btn.link_type === 'file';
              return href && btn.label ? <Button href={href} text={btn.label} download={isDownload} /> : null;
            })}
          </div>
        </section>
      );

    default:
      return <p><em>Unknown block type: {block.acf_fc_layout}</em></p>;
    }
  })();
  return anchorId ? <div id={anchorId} class="scroll-mt-28 md:scroll-mt-32">{inner}</div> : inner;
})}
