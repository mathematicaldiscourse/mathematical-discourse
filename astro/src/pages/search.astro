---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SearchIsland from '../components/SearchIsland.svelte';
import { fetchSearchIndex } from '../lib/wordpress';

export const prerender = true;

const entries = await fetchSearchIndex();
---

<BaseLayout title="Search">
  <PageHero title="Search" />

  <noscript>
    <p><em>Search requires JavaScript to be enabled.</em></p>
  </noscript>

  <SearchIsland client:load entries={entries} />
</BaseLayout>
