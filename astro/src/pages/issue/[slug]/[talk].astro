---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TalkView from '../../../components/TalkView.astro';
import { fetchTalkBySlug, fetchIssueBySlug, fetchTalks, fetchIssues, fetchTalksByIssue } from '../../../lib/wordpress';

export const prerender = true;

export async function getStaticPaths() {
  const issues = await fetchIssues();
  const perIssue = await Promise.all(
    issues.map(async (issue) => {
      const talks = await fetchTalksByIssue(issue.id);
      return talks
        .filter((t) => t.slug)
        .map((t) => ({ params: { slug: issue.slug, talk: t.slug } }));
    })
  );
  return perIssue.flat();
}

const { slug: issueSlug, talk: talkSlug } = Astro.params;
const [talk, issue] = await Promise.all([
  fetchTalkBySlug(talkSlug!),
  fetchIssueBySlug(issueSlug!),
]);

if (!talk || !issue) {
  return Astro.rewrite('/404');
}

const acf = talk.acf;
const talkIssueMap = new Map(
  (await fetchTalks()).filter((t) => t.slug && t.issue_slug).map((t) => [t.slug, t.issue_slug!])
);
const talkDescription = acf.comments?.replace(/<[^>]+>/g, '').replace(/\$[^$]+\$/g, '').trim() || undefined;
const talkUrl = new URL(`/issue/${issueSlug}/${talkSlug}`, Astro.url).toString();
---

<BaseLayout title={talk.title.rendered} description={talkDescription} seo={(talk as any).yoast_head_json} spotColor={issue.acf.issue_color} spotVolume={issue.acf.volume_number} spotIssue={issue.acf.issue_number}>
  <TalkView talk={talk} issue={issue} issueSlug={issueSlug!} talkUrl={talkUrl} talkIssueMap={talkIssueMap} />
</BaseLayout>
